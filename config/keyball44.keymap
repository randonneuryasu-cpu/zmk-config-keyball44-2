#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ScrollDown {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <20 21>;
        };

        RtShift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 20>;
        };

        RtCtl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <31 32>;
        };

        RtAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <32 33>;
        };

        RtWin {
            bindings = <&kp RIGHT_WIN>;
            key-positions = <34 33>;
        };

        LtShift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <16 15>;
        };

        LtCtl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <28 27>;
        };

        LtAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <27 26>;
        };

        LtWin {
            bindings = <&kp LEFT_WIN>;
            key-positions = <25 26>;
        };

        ScrollUp {
            bindings = <&msc SCRL_UP>;
            key-positions = <8 9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Colemak DH";
            bindings = <
&none     &kp Q          &kp W          &kp F      &kp P        &kp B                 &kp J          &kp L  &kp U      &kp Y    &kp SEMICOLON  &none
&none     &kp A          &kp R          &kp S      &kp T        &kp G                 &kp M          &kp N  &kp E      &kp I    &kp O          &none
&none     &kp Z          &kp X          &kp C      &kp D        &kp V                 &kp K          &kp H  &kp COMMA  &kp DOT  &kp SLASH      &kp ESCAPE
&kp LGUI  &kp LG(SPACE)  &kp LC(SPACE)  &lt 2 TAB  &lt 1 ENTER             &kp SPACE  &kp BACKSPACE                                            &none
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&none   &kp LC(HOME)  &kp HOME   &kp UP_ARROW    &kp END        &kp LC(END)                &kp MINUS          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERCENT  &none
&none   &kp LC(LEFT)  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT      &kp LC(RIGHT)              &kp N0             &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SQT      &none
&none   &kp PAGE_UP   &kp LG(V)  &kp LA(LC(V))   &kp LS(LC(V))  &kp PAGE_DOWN              &kp EQUAL          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH    &none
&trans  &trans        &trans     &trans          &kp ENTER                         &trans  &kp RC(BACKSPACE)                                                         &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&bt BT_DISC 0  &kp LG(LEFT)      &kp LG(RIGHT)       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PRINTSCREEN              &kp F12  &kp F7  &kp F8  &kp F9  &kp PIPE              &bt BT_SEL 0
&none          &kp LC(LS(TAB))   &kp LC(TAB)         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp CAPSLOCK                 &kp F11  &kp F4  &kp F5  &kp F6  &kp GRAVE             &bt BT_SEL 1
&none          &kp LA(UP_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(LC(C))         &kp LS(LC(C))          &kp GRAVE                    &kp F10  &kp F1  &kp F2  &kp F3  &kp NON_US_BACKSLASH  &bt BT_SEL 2
&trans         &trans            &trans              &trans                &trans                                      &trans  &kp DEL                                                &kp RA(F4)
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&none   &kp F1  &kp F2   &kp F3   &kp F4   &none              &none  &none  &none  &none  &none  &none
&none   &kp F5  &kp F6   &kp F7   &kp F8   &none              &none  &none  &none  &none  &none  &none
&none   &kp F9  &kp F10  &kp F11  &kp F12  &none              &none  &none  &none  &none  &none  &none
&trans  &trans  &trans   &trans   &trans              &trans  &mo 3                              &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none   &kp N1          &kp N2          &kp N3        &kp N4     &kp N5              &kp N6         &kp N7     &kp N8  &kp N9  &kp N0     &none
&none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none               &kp PAGE_UP    &mkp LCLK  &none   &none   &mkp RCLK  &none
&none   &none           &none           &none         &none      &none               &kp PAGE_DOWN  &none      &none   &none   &none      &none
&trans  &trans          &trans          &trans        &trans                 &trans  &trans                                               &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };
    };
};
